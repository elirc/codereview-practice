# Shared
DATABASE_URL=postgres://wfe:wfe@localhost:5465/wfe
RUST_LOG=info
CLOCK_SKEW_WARN_MS=5000
CLOCK_SYNC_ENABLED=true
DB_MAX_CONNECTIONS=10

# wfe-server
BIND_ADDR=0.0.0.0:8130
LOOPS_ENABLED=true
RETENTION_DAYS=14

# wfe-worker
WORKER_QUEUES=default,email,reports
WORKER_CONCURRENCY=8
POLL_INTERVAL_MS=500
SHUTDOWN_GRACE_SECONDS=30
LEASE_SAFETY_MS=2000
