# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=8100
LOG_LEVEL=info
# Optional; a random id is generated per process when unset.
INSTANCE_ID=

# Backing services (see compose.yaml)
DATABASE_URL=postgres://collab:collab@localhost:5462/collab
REDIS_URL=redis://localhost:6391

# Exact origin of the web client; mutating requests and WebSocket upgrades must carry it.
APP_ORIGIN=http://localhost:5180

# Background loops in the server process (catch-up, permission sweep, liveness, idle rooms)
LOOPS_ENABLED=true

# WebSocket limits
MAX_CONNECTIONS_PER_USER_PER_DOC=8
MAX_ANONYMOUS_CONNECTIONS_PER_DOC=50
WS_RATE_PER_SEC=50
WS_RATE_BURST=100
MAX_UPDATE_BYTES=262144
MAX_DOC_BYTES=5242880

# Server loop intervals (milliseconds)
ROOM_IDLE_MS=30000
CATCHUP_INTERVAL_MS=10000
PERM_SWEEP_MS=15000
PING_INTERVAL_MS=30000

# Worker thresholds
COMPACT_MIN_UPDATES=200
COMPACT_MIN_BYTES=1048576
AUTO_VERSION_MINUTES=10
TRASH_RETENTION_DAYS=30

# Integration tests only
TEST_DATABASE_URL=postgres://collab:collab@localhost:5462/collab_test
TEST_REDIS_URL=redis://localhost:6391
