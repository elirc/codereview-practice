{
  "name": "collab-docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:server": "tsx watch --env-file=.env server/src/main.ts",
    "start:server": "tsx --env-file=.env server/src/main.ts",
    "start:worker": "tsx --env-file=.env server/src/worker/main.ts",
    "migrate": "tsx --env-file=.env server/src/db/migrateCli.ts",
    "seed": "tsx --env-file=.env server/src/seed.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "typecheck": "tsc -p server/tsconfig.json && tsc -p web/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.1",
    "fastify": "5.2.0",
    "ioredis": "5.4.1",
    "kysely": "0.27.5",
    "lib0": "0.2.98",
    "pg": "8.13.1",
    "pino": "9.6.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.1",
    "ws": "8.18.0",
    "y-protocols": "1.0.6",
    "yjs": "13.6.20",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@types/ws": "8.5.13",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.17.0",
    "prettier": "3.4.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.1",
    "vite": "6.0.5",
    "vitest": "2.1.8"
  }
}
