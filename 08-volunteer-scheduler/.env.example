# development | test | production
NODE_ENV=development

# SQLite database file shared by the web server and the worker
DATABASE_PATH=data/volunteer-scheduler.sqlite

# IANA zone used for shift times, reminders, quiet hours and exports
ORG_TIMEZONE=America/New_York

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Login session lifetime
SESSION_TTL_DAYS=14

# Notification providers (only the console implementations exist)
EMAIL_PROVIDER=console
SMS_PROVIDER=console

# Read by @sveltejs/adapter-node when running the production build
PORT=3000
ORIGIN=http://localhost:3000
# Volunteer CSV uploads can be up to 2 MiB; leave headroom for multipart encoding
BODY_SIZE_LIMIT=3145728
