# Shared by all three services
AUTH_JWT_SECRET=dev-only-secret-change-me-at-least-32-bytes
NATS_URL=nats://localhost:6393
APP_CURRENCY=USD
LOOPS_ENABLED=true
LOG_LEVEL=info

# orders
ORDERS_HTTP_ADDR=:8111
ORDERS_DATABASE_URL=postgres://dd_orders:dd_orders@localhost:5463/dd_orders?sslmode=disable
BASE_FEE_MINOR=199
PER_KM_MINOR=60
MAX_DISTANCE_M=15000
QUOTE_TTL=5m
CONFIRM_TIMEOUT=5m
MAX_ACTIVE_ORDERS=3
CANCEL_FEE_MINOR=500
CANCEL_REQUEST_RETRY=2m

# dispatch
DISPATCH_HTTP_ADDR=:8112
DISPATCH_DATABASE_URL=postgres://dd_dispatch:dd_dispatch@localhost:5463/dd_dispatch?sslmode=disable
SEARCH_TIMEOUT=10m
MAX_OFFERS=5
OFFER_TTL=30s
OFFER_RETRY=5s
OFFER_RADIUS_M=5000
POSITION_MAX_AGE=120s
RESERVE_TIMEOUT=20s
COURIER_BASE_MINOR=300
COURIER_SHARE_BPS=8000
CANCEL_COMPENSATION_MINOR=400

# couriers
COURIERS_HTTP_ADDR=:8113
COURIERS_DATABASE_URL=postgres://dd_couriers:dd_couriers@localhost:5463/dd_couriers?sslmode=disable

# Integration and end-to-end tests (unset to skip)
TEST_DATABASE_URL_ORDERS=postgres://dd_orders:dd_orders@localhost:5463/dd_orders?sslmode=disable
TEST_DATABASE_URL_DISPATCH=postgres://dd_dispatch:dd_dispatch@localhost:5463/dd_dispatch?sslmode=disable
TEST_DATABASE_URL_COURIERS=postgres://dd_couriers:dd_couriers@localhost:5463/dd_couriers?sslmode=disable
TEST_NATS_URL=nats://localhost:6395
