# Web app
NODE_ENV=development
DATABASE_URL=postgres://cms:cms@localhost:5456/cms
LOG_LEVEL=info

# Shared by the web app and the scheduler; at least 32 characters.
CRON_SECRET=dev-cron-secret-change-me-0123456789abcdef
# Web app only: set to the old secret while rotating, then remove.
# CRON_SECRET_PREVIOUS=

# Media storage: "s3" (MinIO locally) or "memory" (process-local, dev only)
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9006
S3_REGION=us-east-1
S3_BUCKET=cms-media
S3_ACCESS_KEY_ID=cms-minio
S3_SECRET_ACCESS_KEY=cms-minio-secret

# Scheduler process
APP_URL=http://localhost:3006
SCHEDULER_INTERVAL_MS=30000

# Integration tests run against this database
TEST_DATABASE_URL=postgres://cms:cms@localhost:5456/cms_test
