# Postgres connection: a postgres:// URL or an Npgsql connection string.
DATABASE_URL=postgres://billing:billing@localhost:5464/billing
# Used only by the integration tests.
TEST_DATABASE_URL=postgres://billing:billing@localhost:5464/billing_test
# HTTP port of the API process.
PORT=8120
# Minutes after local midnight of a period end before the boundary is billed.
USAGE_GRACE_MINUTES=60
# Oldest accepted usage event, in days before now.
USAGE_MAX_AGE_DAYS=35
# Allow plain http webhook endpoint URLs (development only).
WEBHOOK_ALLOW_HTTP=false
# Payment gateway implementation; only "fake" ships with this project.
PAYMENT_GATEWAY=fake
# Comma-separated worker loops to run in this worker process.
WORKER_LOOPS=billing,payments,refunds,webhook-fanout,webhook-delivery,purge
# Host environment; the seed command refuses to run in Production.
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development
