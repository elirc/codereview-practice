# Copy to backend/.env (the API reads .env from its working directory).
APP_ENV=development
DATABASE_URL=postgresql+psycopg://expense:expense@localhost:5452/expense
# Integration tests use a separate database (created by docker/init-test-db.sql).
TEST_DATABASE_URL=postgresql+psycopg://expense:expense@localhost:5452/expense_test
BASE_CURRENCY=USD
RECEIPT_STORAGE_DIR=./var/receipts
SESSION_TTL_HOURS=12
LOG_LEVEL=INFO
