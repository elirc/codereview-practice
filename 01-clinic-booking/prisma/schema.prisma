generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  PROVIDER
  STAFF
  ADMIN
}

enum AppointmentStatus {
  BOOKED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum ExceptionKind {
  CLOSED
  CUSTOM_HOURS
}

enum ReminderKind {
  T24H
  T2H
}

enum ReminderStatus {
  PENDING
  SENDING
  SENT
  SKIPPED
  FAILED
}

enum NotificationKind {
  CANCELLATION
  RESCHEDULED
}

model Clinic {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  timezone           String
  minLeadMinutes     Int        @default(60) @map("min_lead_minutes")
  bookingHorizonDays Int        @default(90) @map("booking_horizon_days")
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  users              User[]
  providers          Provider[]

  @@map("clinics")
}

model User {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                 String        @unique
  passwordHash          String        @map("password_hash")
  role                  Role
  clinicId              String?       @map("clinic_id") @db.Uuid
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  clinic                Clinic?       @relation(fields: [clinicId], references: [id])
  sessions              Session[]
  patient               Patient?
  provider              Provider?
  bookedAppointments    Appointment[] @relation("BookedBy")
  cancelledAppointments Appointment[] @relation("CancelledBy")

  @@map("users")
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Patient {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String        @unique @map("user_id") @db.Uuid
  fullName     String        @map("full_name")
  phone        String?
  timezone     String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@map("patients")
}

model Provider {
  id           String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String                  @unique @map("user_id") @db.Uuid
  clinicId     String                  @map("clinic_id") @db.Uuid
  displayName  String                  @map("display_name")
  specialty    String
  active       Boolean                 @default(true)
  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinic       Clinic                  @relation(fields: [clinicId], references: [id])
  rules        AvailabilityRule[]
  exceptions   AvailabilityException[]
  appointments Appointment[]

  @@index([clinicId])
  @@map("providers")
}

model AvailabilityRule {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerId  String    @map("provider_id") @db.Uuid
  weekday     Int
  startLocal  String    @map("start_local") @db.VarChar(5)
  endLocal    String    @map("end_local") @db.VarChar(5)
  slotMinutes Int       @map("slot_minutes")
  validFrom   DateTime  @map("valid_from") @db.Date
  validTo     DateTime? @map("valid_to") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  provider    Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, weekday])
  @@map("availability_rules")
}

model AvailabilityException {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerId  String        @map("provider_id") @db.Uuid
  localDate   DateTime      @map("local_date") @db.Date
  kind        ExceptionKind
  startLocal  String?       @map("start_local") @db.VarChar(5)
  endLocal    String?       @map("end_local") @db.VarChar(5)
  slotMinutes Int?          @map("slot_minutes")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  provider    Provider      @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, localDate])
  @@map("availability_exceptions")
}

model Appointment {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerId        String            @map("provider_id") @db.Uuid
  patientId         String            @map("patient_id") @db.Uuid
  startsAt          DateTime          @map("starts_at") @db.Timestamptz(3)
  endsAt            DateTime          @map("ends_at") @db.Timestamptz(3)
  status            AppointmentStatus @default(BOOKED)
  reason            String?           @db.VarChar(500)
  bookedByUserId    String            @map("booked_by_user_id") @db.Uuid
  cancelledAt       DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  cancelledByUserId String?           @map("cancelled_by_user_id") @db.Uuid
  cancelReason      String?           @map("cancel_reason") @db.VarChar(500)
  lateCancel        Boolean           @default(false) @map("late_cancel")
  rescheduledFromId String?           @map("rescheduled_from_id") @db.Uuid
  idempotencyKey    String?           @map("idempotency_key") @db.VarChar(64)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  provider          Provider          @relation(fields: [providerId], references: [id])
  patient           Patient           @relation(fields: [patientId], references: [id])
  bookedBy          User              @relation("BookedBy", fields: [bookedByUserId], references: [id])
  cancelledBy       User?             @relation("CancelledBy", fields: [cancelledByUserId], references: [id])
  rescheduledFrom   Appointment?      @relation("Reschedule", fields: [rescheduledFromId], references: [id])
  rescheduledTo     Appointment[]     @relation("Reschedule")
  reminders         Reminder[]
  notifications     AppointmentNotification[]

  @@index([providerId, startsAt])
  @@index([patientId, startsAt])
  @@map("appointments")
}

model Reminder {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  appointmentId String         @map("appointment_id") @db.Uuid
  kind          ReminderKind
  scheduledFor  DateTime       @map("scheduled_for") @db.Timestamptz(3)
  status        ReminderStatus @default(PENDING)
  attempts      Int            @default(0)
  claimedAt     DateTime?      @map("claimed_at") @db.Timestamptz(3)
  sentAt        DateTime?      @map("sent_at") @db.Timestamptz(3)
  lastError     String?        @map("last_error")
  appointment   Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, kind])
  @@index([status, scheduledFor])
  @@map("reminders")
}

model AppointmentNotification {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  appointmentId String           @map("appointment_id") @db.Uuid
  kind          NotificationKind
  status        ReminderStatus   @default(PENDING)
  attempts      Int              @default(0)
  claimedAt     DateTime?        @map("claimed_at") @db.Timestamptz(3)
  sentAt        DateTime?        @map("sent_at") @db.Timestamptz(3)
  lastError     String?          @map("last_error")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  appointment   Appointment      @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, kind])
  @@index([status, createdAt])
  @@map("appointment_notifications")
}
