# Copy to .env for local development.
NODE_ENV=development

# Postgres from docker-compose.yml (host port 5451).
DATABASE_URL=postgresql://clinic:clinic@localhost:5451/clinic_booking?schema=public

# Used by the integration tests; the compose init script creates this database.
TEST_DATABASE_URL=postgresql://clinic:clinic@localhost:5451/clinic_booking_test?schema=public

# Origin the browser uses to reach the web app; mutating API requests must match it.
APP_ORIGIN=http://localhost:3000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# console (prints emails to the log) | memory (keeps them in process, for tests)
MAILER=console
MAIL_FROM=appointments@clinic.example
