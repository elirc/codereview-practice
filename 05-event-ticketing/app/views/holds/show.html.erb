<% content_for :title, "Checkout" %>

<h1>Checkout — <%= @event.title %></h1>

<p>
  <%= @hold.quantity %> × <%= @tier.name %> at <%= format_cents(@hold.unit_price_cents) %> each
</p>

<% if @hold.live?(@now) %>
  <section data-controller="countdown" data-countdown-expires-at-value="<%= @hold.expires_at.utc.iso8601 %>">
  <p>
    Your tickets are held until
    <%= format_in_zone(@hold.expires_at, @event.time_zone) %>
    (<span class="countdown" data-countdown-target="remaining"></span> left).
  </p>

  <%= render "holds/quote", hold: @hold, quote: @quote, error: nil %>

  <%= form_with url: hold_checkout_path(@hold), id: "checkout-form" do |form| %>
    <div class="field">
      <%= form.label :payment_token, "Payment token" %>
      <%= form.text_field :payment_token, value: "tok_visa", required: true, maxlength: 200 %>
      <p class="muted">Test gateway: any token is approved except <code>tok_decline</code>.</p>
    </div>
    <%= form.submit "Pay now", data: { countdown_target: "submit" } %>
  <% end %>
  </section>

  <%= button_to "Release tickets", hold_path(@hold), method: :delete %>
<% else %>
  <p class="flash alert" data-error-code="hold_expired">This hold is no longer active.</p>
  <p><%= link_to "Back to the event", event_path(@event) %></p>
<% end %>
