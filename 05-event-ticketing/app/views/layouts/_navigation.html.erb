<nav>
  <strong><%= link_to "Event Ticketing", root_path %></strong>
  <% if authenticated? %>
    <% if current_user.manager? %>
      <%= link_to "Manage", manage_events_path %>
    <% end %>
    <span class="muted"><%= current_user.name %> (<%= current_user.role %>)</span>
    <%= button_to "Sign out", session_path, method: :delete %>
  <% else %>
    <%= link_to "Sign in", new_session_path %>
    <%= link_to "Sign up", new_registration_path %>
  <% end %>
</nav>
