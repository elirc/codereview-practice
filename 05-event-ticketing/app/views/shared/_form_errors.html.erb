<% if record.errors.any? %>
  <div class="form-errors" data-error-code="validation_failed">
    <p><%= pluralize(record.errors.count, "problem") %> prevented saving:</p>
    <ul>
      <% record.errors.each do |error| %>
        <li data-field="<%= error.attribute %>"><%= error.full_message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
