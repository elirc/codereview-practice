# Rails does not load this file automatically; export the values (for example
# `set -a; source .env; set +a`) before running bin/rails or bin/jobs.

RAILS_ENV=development
# Optional in development and test (defaults point at docker-compose on port 5455).
# Required in production.
DATABASE_URL=postgres://postgres:postgres@localhost:5455/event_ticketing_development
DB_POOL=15
RAILS_MAX_THREADS=3
PORT=3000
JOB_CONCURRENCY=1
RAILS_LOG_LEVEL=info
APP_HOST=localhost:3000
MAIL_FROM=tickets@example.com
PAYMENT_GATEWAY=fake
# succeed | decline
FAKE_GATEWAY_MODE=succeed
# Required in production only. Generate with `bin/rails secret`.
SECRET_KEY_BASE=
