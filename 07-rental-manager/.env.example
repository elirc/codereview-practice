# Postgres from docker-compose.yml (host port 5457).
DATABASE_URL=postgres://rentmgr:rentmgr@localhost:5457/rentmgr?sslmode=disable
# Used only by integration tests; they are skipped when it is empty.
TEST_DATABASE_URL=postgres://rentmgr:rentmgr@localhost:5457/rentmgr_test?sslmode=disable
HTTP_ADDR=:8087
# development | test | production (production marks cookies Secure)
APP_ENV=development
# Business time zone used to derive "today" for postings and jobs.
APP_TIMEZONE=America/Chicago
# debug | info | warn | error
LOG_LEVEL=info
